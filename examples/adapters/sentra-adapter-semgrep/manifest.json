{
  "id": "org.sentra.adapter.semgrep",
  "name": "Semgrep SAST Analysis Adapter",
  "version": "2.0.0",
  "interface_version": 1,
  "family": "analysis_tool",
  "executable_path": "python adapter.py",
  "declared_capabilities": [
    "static_analysis"
  ],
  "quotas": {
    "max_memory_mib": 1024,
    "max_execution_time_secs": 120,
    "max_frame_bytes": 1048576,
    "max_total_output_bytes": 10485760
  },
  "egress_policy": "strictly_denied"
}
